# Supabase Postgres (pooler, para Vercel)
DATABASE_URL=postgresql+asyncpg://postgres.proyecto:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Sync URL para Alembic (psycopg2)
DATABASE_URL_SYNC=postgresql://postgres.proyecto:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

SUPABASE_URL=https://proyecto.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# JWT propio
JWT_SECRET=change-me-32-chars-minimum-please
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15
JWT_REFRESH_DAYS=7

# CORS
CORS_ORIGINS=https://barena-frontend.vercel.app,http://localhost:3000

# Feature flags
FREEMIUM=true
REALTIME_ENABLED=true
